{
    "name": "SharePoint_Site_Template",
    "properties": {
        "parameters": {
            "SiteId": {
                "type": "string",
                "defaultValue": ""
            },
            "DriveId": {
                "type": "string", 
                "defaultValue": ""
            },
            "SiteName": {
                "type": "string",
                "defaultValue": ""
            },
            "LibraryName": {
                "type": "string",
                "defaultValue": "Dokumente"
            }
        },
        "activities": [
            {
                "name": "GetBearerToken",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": true,
                    "secureInput": true
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "url": "https://login.microsoftonline.com/3cb927ea-38d4-4f40-a2e3-0d1eb5234b2a/oauth2/v2.0/token",
                    "body": "grant_type=client_credentials&client_id=65b1ec57-eaf8-4c07-832c-26f2eb6663b4&client_secret=9nr8Q~zatKvsOPQ5FLPO8wOa64B_6b1Dhe3ahaPf&scope=https://graph.microsoft.com/.default"
                }
            },
            {
                "name": "GetAllItems",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "GetBearerToken",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "headers": {
                        "Authorization": "@{concat('Bearer ', activity('GetBearerToken').output.access_token)}"
                    },
                    "url": "@{concat('https://graph.microsoft.com/v1.0/sites/', pipeline().parameters.SiteId, '/drives/', pipeline().parameters.DriveId, '/root/delta')}"
                }
            },
            {
                "name": "FilterFiles",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "GetAllItems",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('GetAllItems').output.value",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@contains(string(item()), '\"mimeType\"')",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "StartTimer",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "FilterFiles",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "variableName": "StartTime",
                    "value": "@utcnow()"
                }
            },
            {
                "name": "ForEachFile",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "StartTimer",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('FilterFiles').output.value",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 20,
                    "activities": [
                        {
                            "name": "CopyFileWithName",
                            "type": "Copy",
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "BinarySource",
                                    "storeSettings": {
                                        "type": "HttpReadSettings",
                                        "requestMethod": "GET",
                                        "additionalHeaders": "@{concat('Authorization: Bearer ', activity('GetBearerToken').output.access_token)}",
                                        "requestTimeout": ""
                                    },
                                    "formatSettings": {
                                        "type": "BinaryReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "BinarySink",
                                    "storeSettings": {
                                        "type": "AzureBlobStorageWriteSettings",
                                        "copyBehavior": "PreserveHierarchy",
                                        "blockSizeInMB": 100
                                    }
                                },
                                "enableStaging": false,
                                "validateDataConsistency": true,
                                "parallelCopies": 8
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_http_dynamic",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "relativeUrl": "@concat('/v1.0/sites/', pipeline().parameters.SiteId, '/drives/', pipeline().parameters.DriveId, '/items/', item().id, '/content')"
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_blob_dynamic",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "fileName": "@item().name",
                                        "folderPath": "@concat('sharepoint-migration/', pipeline().parameters.SiteName, '/', pipeline().parameters.LibraryName, '/', replace(replace(coalesce(item().parentReference.path, ''), concat('/drives/', pipeline().parameters.DriveId), ''), '/root:', ''))"
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "EndTimer",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "ForEachFile",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "variableName": "EndTime",
                    "value": "@utcnow()"
                }
            }
        ],
        "variables": {
            "StartTime": {
                "type": "String"
            },
            "EndTime": {
                "type": "String"
            }
        },
        "annotations": [],
        "lastPublishTime": "2025-10-15T12:00:00Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}